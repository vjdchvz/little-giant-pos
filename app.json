{
  "expo": {
    "name": "Little Giant POS",
    "slug": "little-giant-pos",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B3060"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vjdechavez.littlegiantpos"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B3060"
      },
      "package": "com.vjdechavez.littlegiantpos",
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "db031bf9-5a59-4245-a71f-74f89154c3ec"
      }
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "owner": "vjdchvz21"
  }
}
